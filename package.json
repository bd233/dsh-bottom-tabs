{
  "name": "dsh-bottom-tabs",
  "version": "0.1.2",
  "description": "Browser-style session tab strip for the DeepSeek Harness Web UI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bd233/dsh-bottom-tabs.git"
  },
  "homepage": "https://github.com/bd233/dsh-bottom-tabs#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tabs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "assets",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
